{
  "name": "@poppykit/cli",
  "version": "0.2.0",
  "private": false,
  "description": "Cross-platform Personal Agent Protocol CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/LMol-4/poppykit-cli.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "test": "npm run build:tests && node scripts/run-checks.mjs all",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "build:tests": "node scripts/build-tests.mjs",
    "coverage": "npm run build && npm run build:tests && node scripts/coverage.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.0"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "docs",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "poppykit": "dist/cli.js"
  },
  "dependencies": {
    "@poppykit/client": "0.2.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
